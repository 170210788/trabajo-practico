<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Global Market</title>
    <style>
        :root { 
            --black: #000000; 
            --dark: #0a0a0a; 
            --panel: #121212; 
            --red: #e11d48; 
            --red-hover: #be123c; 
            --blue: #2563eb; 
            --blue-hover: #1d4ed8; 
            --white: #ffffff; 
            --gray: #a3a3a3; 
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: system-ui, sans-serif; }
        body { background: var(--black); color: var(--white); line-height: 1.5; }
        a { text-decoration: none; color: inherit; }
        
        header { background: var(--dark); border-bottom: 3px solid var(--red); position: sticky; top: 0; z-index: 100; }
        .top-bar, .container, footer { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
        .logo { font-size: 1.5rem; font-weight: 900; color: var(--white); letter-spacing: -0.05em; }
        .logo span { color: var(--red); }
        .search { flex: 1; max-width: 400px; display: flex; background: var(--black); border-radius: 99px; border: 1px solid var(--gray); overflow: hidden; }
        .search input { flex: 1; background: transparent; border: none; padding: 0.5rem 1rem; color: var(--white); outline: none; font-size: 0.85rem; }
        .search input::placeholder { color: var(--gray); }
        .search button { background: var(--red); border: none; padding: 0 1rem; cursor: pointer; color: var(--white); }
        
        nav.menu { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 0.75rem; display: flex; gap: 1.5rem; overflow-x: auto; font-size: 0.75rem; font-weight: 700; color: var(--gray); }
        nav.menu a:hover { color: var(--red); }

        .container { flex-direction: column; gap: 2rem; margin: 2rem auto; display: flex; }
        
        .hero { background: linear-gradient(135deg, var(--dark), var(--black)); border: 2px solid var(--blue); border-radius: 0.5rem; padding: 3rem; display: flex; justify-content: space-between; align-items: center; }
        .tag { background: var(--red); color: var(--white); font-size: 0.7rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 99px; text-transform: uppercase; display: inline-block; margin-bottom: 0.75rem; }
        .hero h1 { font-size: 2.2rem; margin-bottom: 0.75rem; font-weight: 900; color: var(--white); }
        .hero p { color: var(--gray); font-size: 0.95rem; margin-bottom: 1.2rem; }
        .primary-button { background: var(--blue); color: var(--white); border: none; padding: 0.75rem 1.5rem; font-weight: 700; border-radius: 0.3rem; cursor: pointer; transition: 0.2s; }
        .primary-button:hover { background: var(--blue-hover); }
        .hero-ball { font-size: 6rem; }

        .section-title, .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
        .section-title h2, .panel-header h2 { font-size: 1.2rem; font-weight: 800; color: var(--white); }
        .section-title a, .panel-header a { font-size: 0.85rem; color: var(--blue); font-weight: 600; }
        .section-title a:hover, .panel-header a:hover { text-decoration: underline; }

        .news-grid, .columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; width: 100%; }
        .news-card, .panel { background: var(--panel); border-radius: 0.5rem; overflow: hidden; border: 1px solid #262626; transition: border-color 0.2s; }
        .news-card:hover { border-color: var(--red); }
        .news-image { background: var(--dark); border-bottom: 1px solid #262626; height: 120px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
        .news-content { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
        .news-content span { font-size: 0.65rem; color: var(--red); font-weight: 800; letter-spacing: 0.05em; }
        .news-content h3 { font-size: 0.95rem; font-weight: 700; color: var(--white); }
        .news-content p { font-size: 0.7rem; color: var(--gray); }

        .panel { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
        .player, .transfer { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid #262626; }
        .player:last-child, .transfer:last-child { border: none; }
        .player-avatar { width: 2.2rem; height: 2.2rem; background: var(--blue); color: var(--white); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 800; }
        .player-info, .transfer div { flex: 1; margin: 0 1rem; display: flex; flex-direction: column; }
        .player-info strong, .transfer strong { font-size: 0.85rem; color: var(--white); }
        .player-info small, .transfer small { font-size: 0.7rem; color: var(--gray); }
        .number { font-size: 0.85rem; font-weight: 800; color: var(--red); width: 1.5rem; text-align: center; }
        .value, .money { font-size: 0.85rem; font-weight: 800; color: var(--red); }

        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left; }
        th { padding: 0.75rem; background: var(--dark); color: var(--gray); font-weight: 600; border-bottom: 2px solid var(--red); }
        td { padding: 0.75rem; border-bottom: 1px solid #262626; color: var(--white); }

        footer { background: var(--dark); border-top: 3px solid var(--blue); flex-direction: column; gap: 1.5rem; text-align: center; margin-top: 3rem; color: var(--gray); font-size: 0.8rem; }
        .footer-links { display: flex; gap: 1.5rem; justify-content: center; }
        .footer-links a:hover { color: var(--white); }

        @media(max-width: 768px) {
            .hero { flex-direction: column; text-align: center; padding: 2rem; }
            .hero-ball { display: none; }
            .top-bar { flex-wrap: wrap; }
            .search { order: 3; max-width: 100%; flex-basis: 100%; }
        }
    </style>
</head>
<body>
    <header>
        <div class="top-bar">
            <div class="logo">GLOBAL<span>MARKET</span></div>
            <div class="search"><input type="text" placeholder="Buscar jugador, club..."><button>🔍</button></div>
        </div>
        <nav class="menu">
            <a href="#">INICIO</a><a href="#">JUGADORES</a><a href="#">FICHAJES</a><a href="#">RUMORES</a><a href="#">VALORES</a><a href="#">CLUBES</a><a href="#">COMPETICIONES</a>
        </nav>
    </header>

    <main class="container">
        <section class="hero">
            <div class="hero-text">
                <span class="tag">DESTACADO 2026</span>
                <h1>El pulso del mercado global de fichajes del fútbol</h1>
                <p>Valoraciones en vivo, fichajes récord y estadísticas analíticas.</p>
                <button class="primary-button">Explorar novedades</button>
            </div>
            <div class="hero-ball">⚽</div>
        </section>

        <section>
            <div class="section-title"><h2>Últimas noticias</h2><a href="#">Ver todas →</a></div>
            <div class="news-grid">
                <article class="news-card"><div class="news-image">📊</div><div class="news-content"><span>FICHAJES</span><h3>mayores ventas de la historia</h3><p>02/09/2026</p></div></article>
                <article class="news-card"><div class="news-image">🏆</div><div class="news-content"><span>COMPETICIONES</span><h3>Resumen de la ultima temporada</h3><p>02/09/2026</p></div></article>
                <article class="news-card"><div class="news-image">⇄</div><div class="news-content"><span>VALORES</span><h3>intereces del mercado de fichajes</h3><p>01/09/2026</p></div></article>
            </div>
        </section>

        <div class="columns">
            <section class="panel">
                <div class="panel-header"><h2>Jugadores más valiosos</h2><a href="#">Top 100 →</a></div>
                <div class="player"><div class="number">1</div><div class="player-avatar">LY</div><div class="player-info"><strong>Lamine Yamal</strong><small>Extremo der. · Barcelona</small></div><span class="value">€200M</span></div>
                <div class="player"><div class="number">2</div><div class="player-avatar">EH</div><div class="player-info"><strong>Erling Haaland</strong><small>Delantero · Man City</small></div><span class="value">€200M</span></div>
                <div class="player"><div class="number">3</div><div class="player-avatar">KM</div><div class="player-info"><strong>Kylian Mbappé</strong><small>Delantero · Real Madrid</small></div><span class="value">€180M</span></div>
            </section>
            <section class="panel">
                <div class="panel-header"><h2>Últimos fichajes</h2><a href="#">Todos →</a></div>
                <div class="transfer"><div><strong>Andrey Santos</strong><small>Chelsea → Man United</small></div><strong>€40M</strong></div>
                <div class="transfer"><div><strong>Elliot Anderson</strong><small>Newcastle → Man City</small></div><strong>€135M</strong></div>
                <div class="transfer"><div><strong>Sandro Tonali</strong><small>Newcastle → Juventus</small></div><strong>€108M</strong></div>
            </section>
        </div>

        <section class="panel">
            <div class="panel-header"><h2>Clubes más valiosos</h2><a href="#">Ranking completo →</a></div>
            <table>
                <thead><tr><th>#</th><th>Club</th><th>País</th><th>Plantel</th><th>Valor</th></tr></thead>
                <tbody>
                    <tr><td>1</td><td><strong>Manchester City</strong></td><td>🏴 Inglaterra</td><td>27</td><td class="money">€1.35B</td></tr>
                    <tr><td>2</td><td><strong>Real Madrid</strong></td><td>🇪🇸 España</td><td>25</td><td class="money">€1.20B</td></tr>
                    <tr><td>3</td><td><strong>Barcelona</strong></td><td>🇪🇸 España</td><td>26</td><td class="money">€1.10B</td></tr>
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <div class="footer-links"><a href="#">Acerca de</a><a href="#">Contacto</a><a href="#">Privacidad</a><a href="#">Términos</a></div>
        <div>© 2026 Global Market. Todos los derechos reservados.</div>
    </footer>
</body>
</html>
