/* RESET Y CONFIGURACIÓN BÁSICA */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

body {
    background-color: #f4f6f9;
    color: #111827;
    line-height: 1.5;
}

a {
    text-decoration: none;
    color: inherit;
}

/* ENCABEZADO */
.header {
    background-color: #0b1329;
    color: #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 0;
    z-index: 100;
}

.top-bar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
}

.logo {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: #ffffff;
}

.logo span {
    color: #3b82f6;
}

.search {
    flex: 1;
    max-width: 500px;
    display: flex;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
}

.search input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.5rem 1rem;
    color: #ffffff;
    font-size: 0.875rem;
    outline: none;
}

.search input::placeholder {
    color: #9ca3af;
}

.search button {
    background: transparent;
    border: none;
    padding: 0 1rem;
    cursor: pointer;
    font-size: 0.875rem;
}

.login {
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    background-color: #3b82f6;
    transition: background-color 0.2s;
    white-space: nowrap;
}

.login:hover {
    background-color: #2563eb;
}

/* MENÚ */
.menu {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    white-space: nowrap;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.menu a {
    display: block;
    padding: 0.75rem 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #9ca3af;
    transition: color 0.2s;
}

.menu a:hover {
    color: #ffffff;
}

/* CONTENIDO PRINCIPAL */
.container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

/* DESTACADO (HERO) */
.hero {
    background: linear-gradient(135deg, #1e3a8a 0%, #0b1329 100%);
    border-radius: 1rem;
    color: #ffffff;
    padding: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero-text {
    max-width: 600px;
    z-index: 1;
}

.tag {
    display: inline-block;
    background-color: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 1rem;
    letter-spacing: 0.05em;
}

.hero h1 {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
}

.hero p {
    font-size: 1rem;
    color: #9ca3af;
    margin-bottom: 1.5rem;
}

.primary-button {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    padding: 0.75rem 1.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.2s;
}

.primary-button:hover {
    background-color: #2563eb;
}

.hero-ball {
    font-size: 8rem;
    opacity: 0.15;
    user-select: none;
}

/* SECCIÓN Y TÍTULOS */
.section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.section-title, .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.section-title h2, .panel-header h2 {
    font-size: 1.25rem;
    font-weight: 700;
}

.section-title a, .panel-header a {
    font-size: 0.875rem;
    font-weight: 600;
    color: #3b82f6;
}

.section-title a:hover, .panel-header a:hover {
    text-decoration: underline;
}

/* GRID DE NOTICIAS */
.news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

.news-card {
    background-color: #ffffff;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    border: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
}

.news-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

.news-image {
    background-color: #eff6ff;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
}

.news-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.news-content span {
    font-size: 0.7rem;
    font-weight: 700;
    color: #3b82f6;
    letter-spacing: 0.05em;
}

.news-content h3 {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: #1f2937;
}

.news-content p {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.5rem;
}

/* DOS COLUMNAS */
.columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
}

.panel {
    background-color: #ffffff;
    border-radius: 0.75rem;
    padding: 1.5rem;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
    border: 1px solid #e5e7eb;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

/* JUGADORES */
.player {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f3f4f6;
}

.player:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.number {
    font-size: 0.875rem;
    font-weight: 700;
    color: #9ca3af;
    width: 1.5rem;
    text-align: center;
}

.player-avatar {
    width: 2.5rem;
    height: 2.5rem;
    background-color: #e0f2fe;
    color: #0369a1;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
}

.player-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.player-info strong {
    font-size: 0.875rem;
    color: #1f2937;
}

.player-info small {
    font-size: 0.75rem;
    color: #6b7280;
}

.value {
    font-size: 0.875rem;
    font-weight: 700;
    color: #059669;
}

/* FICHAJES */
.transfer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid #f3f4f6;
}

.transfer:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.transfer div {
    display: flex;
    flex-direction: column;
}

.transfer strong {
    font-size: 0.875rem;
    color: #1f2937;
}

.transfer small {
    font-size: 0.75rem;
    color: #6b7280;
}

/* TABLA */
.market {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
}

th {
    padding: 0.75rem;
    background-color: #f9fafb;
    color: #4b5563;
    font-weight: 600;
    border-bottom: 1px solid #e5e7eb;
}

td {
    padding: 0.875rem 0.75rem;
    border-bottom: 1px solid #f3f4f6;
    color: #1f2937;
}

tr:last-child td {
    border-bottom: none;
}

.money {
    font-weight: 700;
    color: #059669;
}

/* PIE DE PÁGINA */
footer {
    background-color: #0b1329;
    color: #9ca3af;
    padding: 3rem 1.5rem 1.5rem;
    margin-top: 4rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.footer-content {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-content .logo {
    color: #ffffff;
}

.footer-content p {
    font-size: 0.875rem;
    max-width: 400px;
}

.footer-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
}

.footer-links a {
    font-size: 0.875rem;
    color: #9ca3af;
    transition: color 0.2s;
}

.footer-links a:hover {
    color: #ffffff;
}

.copyright {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.75rem;
    text-align: center;
}

/* MEDIA QUERIES */
@media (max-width: 768px) {
    .top-bar {
        flex-wrap: wrap;
    }
    
    .search {
        order: 3;
        max-width: 100%;
        flex-basis: 100%;
    }

    .hero {
        padding: 2rem;
        flex-direction: column;
        text-align: center;
    }

    .hero-text {
        max-width: 100%;
    }

    .hero-ball {
        display: none;
    }
}
