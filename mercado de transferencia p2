<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Market</title>
    <style>
        :root { --primary: #6366f1; --primary-dark: #4f46e5; --accent: #ec4899; --bg: #0f172a; --card: #1e293b; --text: #f8fafc; --muted: #94a3b8; }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: system-ui, sans-serif; }
        body { background: var(--bg); color: var(--text); line-height: 1.5; }
        a { text-decoration: none; color: inherit; }
        
        header { background: linear-gradient(135deg, #1e1b4b, #311042); border-bottom: 2px solid rgba(236, 72, 153, 0.3); position: sticky; top: 0; z-index: 100; }
        .top-bar, .container, footer { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
        .logo { font-size: 1.5rem; font-weight: 900; background: linear-gradient(to right, #818cf8, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .search { flex: 1; max-width: 400px; display: flex; background: rgba(255,255,255,0.07); border-radius: 99px; border: 1px solid rgba(255,255,255,0.15); overflow: hidden; }
        .search input { flex: 1; background: transparent; border: none; padding: 0.5rem 1rem; color: #fff; outline: none; font-size: 0.85rem; }
        .search button { background: var(--accent); border: none; padding: 0 1rem; cursor: pointer; color: #fff; }
        .login { background: var(--primary); padding: 0.5rem 1.2rem; border-radius: 0.5rem; font-weight: 700; cursor: pointer; transition: 0.2s; }
        .login:hover { background: var(--primary-dark); }
        
        nav.menu { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 0.75rem; display: flex; gap: 1.5rem; overflow-x: auto; font-size: 0.75rem; font-weight: 700; color: var(--muted); }
        nav.menu a:hover { color: var(--accent); }

        .container { flex-direction: column; gap: 2rem; margin: 2rem auto; }
        
        .hero { background: linear-gradient(135deg, #4f46e5, #9333ea, #ec4899); border-radius: 1rem; padding: 3rem; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 25px -5px rgba(147, 51, 234, 0.4); }
        .tag { background: rgba(0,0,0,0.25); color: #f472b6; font-size: 0.7rem; font-weight: 800; padding: 0.25rem 0.75rem; border-radius: 99px; text-transform: uppercase; }
        .hero h1 { font-size: 2.2rem; margin: 0.75rem 0; font-weight: 800; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
        .hero p { color: #f1f5f9; font-size: 0.95rem; margin-bottom: 1.2rem; }
        .primary-button { background: #fff; color: #1e1b4b; border: none; padding: 0.75rem 1.5rem; font-weight: 700; border-radius: 0.5rem; cursor: pointer; transition: 0.2s; }
        .primary-button:hover { background: #f1f5f9; transform: translateY(-2px); }
        .hero-ball { font-size: 6rem; filter: drop-shadow(0 0 15px rgba(255,255,255,0.4)); }

        .section-title, .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
        .section-title h2, .panel-header h2 { font-size: 1.2rem; font-weight: 800; }
        .section-title a, .panel-header a { font-size: 0.85rem; color: #818cf8; font-weight: 600; }

        .news-grid, .columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; width: 100%; }
        .news-card, .panel { background: var(--card); border-radius: 0.75rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); transition: transform 0.2s; }
        .news-card:hover { transform: translateY(-3px); }
        .news-image { background: linear-gradient(135deg, #312e81, #701a75); height: 120px; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
        .news-content { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.4rem; }
        .news-content span { font-size: 0.65rem; color: var(--accent); font-weight: 800; letter-spacing: 0.05em; }
        .news-content h3 { font-size: 0.95rem; font-weight: 700; }
        .news-content p { font-size: 0.7rem; color: var(--muted); }

        .panel { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }
        .player, .transfer { display: flex; align-items: center; justify-content: space-between; padding: 0.6rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
        .player:last-child, .transfer:last-child { border: none; }
        .player-avatar { width: 2.2rem; height: 2.2rem; background: linear-gradient(135deg, #06b6d4, #3b82f6); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: 800; }
        .player-info, .transfer div { flex: 1; margin: 0 1rem; display: flex; flex-direction: column; }
        .player-info strong, .transfer strong { font-size: 0.85rem; }
        .player-info small, .transfer small { font-size: 0.7rem; color: var(--muted); }
        .value, .money { font-size: 0.85rem; font-weight: 800; color: #34d399; }

        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; text-align: left; }
        th { padding: 0.75rem; background: rgba(255,255,255,0.03); color: var(--muted); font-weight: 600; }
        td { padding: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.05); }

        footer { background: #090d16; border-top: 1px solid rgba(255,255,255,0.08); flex-direction: column; gap: 1.5rem; text-align: center; margin-top: 3rem; color: var(--muted); font-size: 0.8rem; }
        .footer-links { display: flex; gap: 1.5rem; justify-content: center; }
        .footer-links a:hover { color: #fff; }

        @media(max-width: 768px) {
            .hero { flex-direction: column; text-align: center; padding: 2rem; }
            .hero-ball { display: none; }
            .top-bar { flex-wrap: wrap; }
            .search { order: 3; max-width: 100%; flex-basis: 100%; }
        }
    </style>
</head>
<body>
    <header>
        <div class="top-bar">
            <div class="logo">FOOTBALL<span>MARKET</span></div>
            <div class="search"><input type="text" placeholder="Search player, club..."><button>🔍</button></div>
            <div class="login">Sign in</div>
        </div>
        <nav class="menu">
            <a href="#">HOME</a><a href="#">PLAYERS</a><a href="#">TRANSFERS</a><a href="#">RUMOURS</a><a href="#">VALUES</a><a href="#">CLUBS</a><a href="#">COMPETITIONS</a>
        </nav>
    </header>

    <main class="container">
        <section class="hero">
            <div class="hero-text">
                <span class="tag">FEATURED 2026</span>
                <h1>The pulse of global football transfer markets</h1>
                <p>Live valuations, record breaking transfers, and analytics.</p>
                <button class="primary-button">Explore updates</button>
            </div>
            <div class="hero-ball">⚽</div>
        </section>

        <section>
            <div class="section-title"><h2>Latest news</h2><a href="#">View all →</a></div>
            <div class="news-grid">
                <article class="news-card"><div class="news-image">⚽</div><div class="news-content"><span>TRANSFERS</span><h3>Summer transfer market record highs</h3><p>09/02/2026</p></div></article>
                <article class="news-card"><div class="news-image">🏆</div><div class="news-content"><span>COMPETITIONS</span><h3>New season tactical overviews</h3><p>09/02/2026</p></div></article>
                <article class="news-card"><div class="news-image">📈</div><div class="news-content"><span>VALUES</span><h3>Global market value surges</h3><p>09/01/2026</p></div></article>
            </div>
        </section>

        <div class="columns">
            <section class="panel">
                <div class="panel-header"><h2>Top valuations</h2><a href="#">Top 100 →</a></div>
                <div class="player"><div class="number">1</div><div class="player-avatar">LY</div><div class="player-info"><strong>Lamine Yamal</strong><small>RW · Barcelona</small></div><span class="value">€200M</span></div>
                <div class="player"><div class="number">2</div><div class="player-avatar">EH</div><div class="player-info"><strong>Erling Haaland</strong><small>ST · Man City</small></div><span class="value">€200M</span></div>
                <div class="player"><div class="number">3</div><div class="player-avatar">KM</div><div class="player-info"><strong>Kylian Mbappé</strong><small>ST · Real Madrid</small></div><span class="value">€180M</span></div>
            </section>
            <section class="panel">
                <div class="panel-header"><h2>Recent transfers</h2><a href="#">All →</a></div>
                <div class="transfer"><div><strong>Andrey Santos</strong><small>Chelsea → Man United</small></div><strong>€40M</strong></div>
                <div class="transfer"><div><strong>Elliot Anderson</strong><small>Newcastle → Man City</small></div><strong>€135M</strong></div>
                <div class="transfer"><div><strong>Sandro Tonali</strong><small>Newcastle → Juventus</small></div><strong>€108M</strong></div>
            </section>
        </div>

        <section class="panel">
            <div class="panel-header"><h2>Valuable clubs</h2><a href="#">Full ranking →</a></div>
            <table>
                <thead><tr><th>#</th><th>Club</th><th>Country</th><th>Squad</th><th>Value</th></tr></thead>
                <tbody>
                    <tr><td>1</td><td><strong>Manchester City</strong></td><td>🏴 England</td><td>27</td><td class="money">€1.35B</td></tr>
                    <tr><td>2</td><td><strong>Real Madrid</strong></td><td>🇪🇸 Spain</td><td>25</td><td class="money">€1.20B</td></tr>
                    <tr><td>3</td><td><strong>Barcelona</strong></td><td>🇪🇸 Spain</td><td>26</td><td class="money">€1.10B</td></tr>
                </tbody>
            </table>
        </section>
    </main>

    <footer>
        <div class="footer-links"><a href="#">About</a><a href="#">Contact</a><a href="#">Privacy</a><a href="#">Terms</a></div>
        <div>© 2026 Football Market. All rights reserved.</div>
    </footer>
</body>
</html>
